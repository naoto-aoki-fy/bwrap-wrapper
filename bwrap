#!/usr/bin/python3.9 -ISBXutf8
# bwrap-wrapper Python launcher
import os
import sys

# Isolated startup omits the script directory from sys.path.
# Use the installation directory even when invoked through a symlink.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from bwrap_wrapper.runtime import main

main(__file__)
